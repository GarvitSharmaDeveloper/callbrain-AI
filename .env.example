# --- AI (at least one key; tried in AI_PROVIDERS order) ---
NVIDIA_API_KEY=                 # Nemotron via build.nvidia.com (fast, free tier)
AI_PROVIDERS=nvidia,gemini,claude
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# COPILOT_EFFORT=low            # low = fastest on stage; medium = deeper reasoning

# --- Triggerware ---
# simulation = runs anywhere; live = real Triggerware server via the `triggerware` Node SDK
TRIGGERWARE_MODE=simulation
TRIGGERWARE_ADDRESS=localhost:5221          # local server started with `triggerware start`
# TRIGGERWARE_WS_URL=                       # cloud instance (WebSocket) …
# TRIGGERWARE_API_KEY=                      # … plus its API key
TRIGGERWARE_TABLE_PREFIX=orbit_             # Orbit tables are registered as orbit_<table>
TRIGGERWARE_SCHEDULE=*/5 * * * * * *        # 7-field cron: every 5 seconds
ORBIT_FEED_URL=http://localhost:3000        # where Triggerware tables fetch Orbit's live data

# --- Database (optional) ---
# Empty = embedded Postgres (PGlite), zero setup.
# DATABASE_URL=postgres://user:pass@host:5432/db
